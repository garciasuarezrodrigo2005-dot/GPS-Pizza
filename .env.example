# Copia este archivo como .env y llena los valores (el .env NO se sube a git).

# --- Base de datos PostgreSQL ---
GPIZZA_DB_HOST=localhost
GPIZZA_DB_PORT=5432
GPIZZA_DB_NAME=gpizza
GPIZZA_DB_USER=gpizza_user
GPIZZA_DB_PASSWORD=cambia_esta_contrasena
# Base que usan las pruebas automáticas (pytest la borra y la recrea).
GPIZZA_DB_NAME_TEST=gpizza_test

# --- Seguridad ---
# Clave para firmar las cookies de sesión. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
GPIZZA_SECRET_KEY=cambia_esta_clave

# --- Operación ---
GPIZZA_ZONA_HORARIA=America/Mexico_City
# Hora simulada para pruebas o para presentar antes de las 11:00 (formato HH:MM).
# Déjala vacía para usar la hora real.
GPIZZA_HORA_DEMO=
