;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;arcSize=6;" vertex="1" parent="datos"><mxGeometry x="400.0" y="40" width="380.0" height="76" as="geometry"/></mxCell><mxCell id="datos_2" value="psycopg 3 (controlador)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;arcSize=6;" vertex="1" parent="datos"><mxGeometry x="790.0" y="40" width="380.0" height="76" as="geometry"/></mxCell><mxCell id="f_datos" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#455A64;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="630" y="484" as="sourcePoint"/><mxPoint x="630" y="516" as="targetPoint"/></mxGeometry></mxCell><mxCell id="bd" value="Base de datos — PostgreSQL 18 (gpizza)" style="swimlane;html=1;startSize=28;fillColor=#ECEFF1;strokeColor=#455A64;fontStyle=1;fontSize=14;rounded=1;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="678" width="1180" height="130" as="geometry"/></mxCell><mxCell id="bd_0" value="12 tablas con PK, FK, CHECK y UNIQUE&lt;br&gt;&lt;i&gt;db/01_esquema.sql&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;arcSize=6;" vertex="1" parent="bd"><mxGeometry x="10.0" y="40" width="380.0" height="76" as="geometry"/></mxCell><mxCell id="bd_1" value="30 triggers con las reglas de negocio&lt;br&gt;&lt;i&gt;db/02_funciones.sql&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;arcSize=6;" vertex="1" parent="bd"><mxGeometry x="400.0" y="40" width="380.0" height="76" as="geometry"/></mxCell><mxCell id="bd_2" value="Auditoría inmutable&lt;br&gt;&lt;i&gt;db/03_auditoria.sql&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;arcSize=6;" vertex="1" parent="bd"><mxGeometry x="790.0" y="40" width="380.0" height="76" as="geometry"/></mxCell><mxCell id="f_bd" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#455A64;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="630" y="646" as="sourcePoint"/><mxPoint x="630" y="678" as="targetPoint"/></mxGeometry></mxCell><mxCell id="transversal" value="&lt;b&gt;Transversal&lt;/b&gt;&lt;br&gt;Configuración (.env, config.py)&lt;br&gt;Monitoreo: logs y Server-Timing (monitoreo.py)&lt;br&gt;Consola: flask db-reset, db-seed, crear-admin, nueva-sucursal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#000000;fontSize=12;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1250" y="192" width="260" height="130" as="geometry"/></mxCell><mxCell id="externos" value="&lt;b&gt;Servicios externos&lt;/b&gt;&lt;br&gt;OpenStreetMap (mosaicos del mapa)&lt;br&gt;GPS y cámara del dispositivo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEBEE;strokeColor=#000000;fontSize=12;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1250" y="30" width="260" height="130" as="geometry"/></mxCell><mxCell id="f_ext" value="HTTPS" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="presentacion" target="externos"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="f_tr" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;endArrow=open;" edge="1" parent="1" source="transversal" target="servicios"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="nota_capas" value="Cada capa solo usa a la de abajo. Las reglas de negocio se validan dos veces: en los servicios (mensajes claros) y en la base de datos con CHECK y triggers (garantía aunque alguien use SQL directo)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=12;arcSize=6;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1250" y="354" width="260" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="despliegue" name="Despliegue"><mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1200" pageHeight="500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cel" value="&lt;b&gt;«dispositivo» Celular&lt;/b&gt;&lt;br&gt;Android 10+ / iOS 14+&lt;br&gt;Navegador → PWA instalada&lt;br&gt;&lt;i&gt;Cliente y repartidor (GPS, cámara)&lt;/i&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;fillColor=#E1F5FE;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="250" height="120" as="geometry"/></mxCell><mxCell id="pc" value="&lt;b&gt;«dispositivo» PC de sucursal&lt;/b&gt;&lt;br&gt;Chrome / Edge / Firefox&lt;br&gt;&lt;i&gt;Cajero, gerente y administrador&lt;/i&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;fillColor=#E1F5FE;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="250" height="110" as="geometry"/></mxCell><mxCell id="srv" value="&lt;b&gt;«servidor» Servidor de aplicación&lt;/b&gt;&lt;br&gt;Windows o Linux, Python 3.14&lt;br&gt;&lt;br&gt;«artefacto» waitress (servidor WSGI)&lt;br&gt;«artefacto» aplicación Flask gpizza&lt;br&gt;«artefacto» .env (configuración y llaves)&lt;br&gt;«artefacto» logs/rendimiento.log" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;fillColor=#FFF3E0;" vertex="1" parent="1"><mxGeometry x="430" y="110" width="300" height="170" as="geometry"/></mxCell><mxCell id="bdn" value="&lt;b&gt;«servidor» Servidor de base de datos&lt;/b&gt;&lt;br&gt;PostgreSQL 18&lt;br&gt;&lt;br&gt;«base de datos» gpizza (producción)&lt;br&gt;«base de datos» gpizza_test (pruebas)" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;fillColor=#ECEFF1;" vertex="1" parent="1"><mxGeometry x="870" y="110" width="290" height="150" as="geometry"/></mxCell><mxCell id="osm" value="&lt;b&gt;«servicio externo» OpenStreetMap&lt;/b&gt;&lt;br&gt;tile.openstreetmap.org" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=12;fontSize=12;align=left;spacingLeft=8;verticalAlign=top;fillColor=#FFEBEE;" vertex="1" parent="1"><mxGeometry x="430" y="360" width="300" height="80" as="geometry"/></mxCell><mxCell id="c1" value="HTTPS (red local o internet)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="cel" target="srv"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c2" value="HTTP/HTTPS" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="pc" target="srv"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c3" value="TCP 5432 (psycopg)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="srv" target="bdn"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c4" value="HTTPS (mosaicos)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="cel" target="osm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c5" value="HTTPS" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="pc" target="osm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="nota_d" value="Configuración mínima de la demostración: el servidor de aplicación y PostgreSQL en la misma PC; los celulares se conectan por la red Wi-Fi local con HTTPS. Para producción, ambos servidores pueden ir en la nube sin cambiar el código (RNF-008)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontSize=12;arcSize=6;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="870" y="330" width="290" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>