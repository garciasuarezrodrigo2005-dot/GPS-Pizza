<mxfile host="drawio"><diagram id="capas" name="Arquitectura en capas"><mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1560" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="presentacion" value="Capa de presentación — navegador del usuario (PWA)" style="swimlane;html=1;startSize=28;fillColor=#E1F5FE;strokeColor=#455A64;fontStyle=1;fontSize=14;rounded=1;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1180" height="130" as="geometry"/></mxCell><mxCell id="presentacion_0" value="Plantillas Jinja2&lt;br&gt;&lt;i&gt;templates/cliente, cajero, repartidor, gerente, admin&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;arcSize=6;" vertex="1" parent="presentacion"><mxGeometry x="10.0" y="40" width="224.0" height="76" as="geometry"/></mxCell><mxCell id="presentacion_1" value="HTMX + Bootstrap 5&lt;br&gt;&lt;i&gt;pantallas que se actualizan solas&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;arcSize=6;" vertex="1" parent="presentacion"><mxGeometry x="244.0" y="40" width="224.0" height="76" as="geometry"/></mxCell><mxCell id="presentacion_2" value="JavaScript propio&lt;br&gt;&lt;i&gt;pedido.js, sucursales.js, mapa.js, repartidor.js, escaner.js&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;arcSize=6;" vertex="1" parent="presentacion"><mxGeometry x="478.0" y="40" width="224.0" height="76" as="geometry"/></mxCell><mxCell id="presentacion_3" value="Service worker + manifest&lt;br&gt;&lt;i&gt;instalable, página sin conexión&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;arcSize=6;" vertex="1" parent="presentacion"><mxGeometry x="712.0" y="40" width="224.0" height="76" as="geometry"/></mxCell><mxCell id="presentacion_4" value="Leaflet + Chart.js&lt;br&gt;&lt;i&gt;mapas y gráficas&l